generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  contracts    Contract[]
}

model Contract {
  id                String       @id @default(cuid())
  userId            String
  fileName          String
  fileUrl           String
  extractedText     String?
  status            ContractStatus @default(UPLOADED)
  waitpointTokenId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id])
  clauses           Clause[]
  finalReport       FinalReport?
}

model Clause {
  id           String          @id @default(cuid())
  contractId   String
  text         String
  orderIndex   Int
  status       ClauseStatus    @default(PENDING)
  createdAt    DateTime        @default(now())
  contract     Contract        @relation(fields: [contractId], references: [id])
  analysis     ClauseAnalysis?
  decision     ReviewDecision?
}

model ClauseAnalysis {
  id                 String    @id @default(cuid())
  clauseId           String    @unique
  riskLevel          RiskLevel
  riskExplanation    String
  ambiguousLanguage  String
  recommendations    String
  createdAt          DateTime  @default(now())
  clause             Clause    @relation(fields: [clauseId], references: [id])
}

model ReviewDecision {
  id         String           @id @default(cuid())
  clauseId   String           @unique
  decision   DecisionType
  annotation String?
  reviewedAt DateTime         @default(now())
  clause     Clause           @relation(fields: [clauseId], references: [id])
}

model FinalReport {
  id         String   @id @default(cuid())
  contractId String   @unique
  content    String
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id])
}

enum ContractStatus {
  UPLOADED
  EXTRACTING_TEXT
  SPLITTING_CLAUSES
  ANALYZING_CLAUSES
  AWAITING_REVIEW
  REVIEW_SUBMITTED
  GENERATING_SUMMARY
  COMPLETED
  FAILED
}

enum ClauseStatus {
  PENDING
  ANALYZING
  ANALYZED
  REVIEWED
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum DecisionType {
  APPROVED
  REJECTED
}